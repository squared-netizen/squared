<?xml version="1.0" encoding="utf-8"?>
<!--
  The Squared mark: a square ring with a smaller solid square centred inside
  it. A square, squared.

  This file is YOURS (ownership class: seeded). It is a vector path rather than
  a PNG on purpose — the default icon is text, reviewable in a diff, and
  editable without an image editor on a phone.

  Adaptive icons are cropped to the centre 72 of 108 units by the launcher, so
  all geometry stays inside 18..90. res/mipmap-hdpi/ic_launcher.png is the
  legacy fallback for API < 26 and draws the same shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M26,26 h56 v56 h-56 z
                          M35,35 h38 v38 h-38 z
                          M46,46 h16 v16 h-16 z" />
</vector>
