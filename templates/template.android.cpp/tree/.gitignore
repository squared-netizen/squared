# The build's output: this project's build/ and the vendored framework's
# release and debug trees. Not every build/: squared/build/ also holds
# common.mk, the framework's build settings, which a clone needs to build.
/build/
squared/build/release/
squared/build/debug/
*.o
*.d
*.apk
*.idsig

.cache/
compile_commands.json
.clangd/

# Generator transaction staging, if a run was interrupted before its rename.
.*.squared-tmp/

# Your own build settings (see the Makefile).
/local.mk

# Signing material never belongs in a repository.
*.keystore
*.jks
