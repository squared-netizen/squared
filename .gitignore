/build/
/dist/

# kit.sfml payload — aarch64 binaries, built by squared-pg tools/build-sfml.sh.
# Shipped inside the cartridge at release time, never committed.
/kits/kit.sfml/tree/sq_kit/lib/
/kits/kit.sfml/tree/sq_kit/include/SFML/
/kits/kit.sfml/tree/sq_kit/BUILD-INFO

# Framework development inside a package payload. build/common.mk is source
# and stays tracked; everything else under build/ is output.
packages/*/tree/squared/build/release/
packages/*/tree/squared/build/debug/
packages/*/tree/squared/local.mk
