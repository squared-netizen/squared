/build/
/dist/

# kit.sfml payload — aarch64 binaries, built by squared-pg tools/build-sfml.sh.
# Shipped inside the cartridge at release time, never committed.
/kits/kit.sfml/tree/sq_kit/lib/
/kits/kit.sfml/tree/sq_kit/include/SFML/
/kits/kit.sfml/tree/sq_kit/BUILD-INFO

# Framework development inside a package payload. The files directly in
# squared/build/ (common.mk, modules.mk) are source and stay tracked; every
# directory under it is output: release, debug, host, cache, lint-android
# (lint's Android BMIs, committed once by `git add -A`, 2026-11-02).
packages/*/tree/squared/build/*/
packages/*/tree/squared/local.mk

*.bak.[0-9]*-[0-9]*
