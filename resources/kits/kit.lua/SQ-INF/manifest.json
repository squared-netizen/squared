{
  "format": "squared-cartridge",
  "format_version": 2,
  "kind": "kit",
  "id": "kit.lua",
  "version": "0.1.0",
  "tree": "tree/",
  "title": "Lua Scripting Kit",
  "description": "Adds an embedded Lua 5.4 interpreter and an sq_lua/ script workspace alongside sq_app/.",
  "requires_features": [],
  "license": "MIT",
  "authors": [
    {
      "name": "squared-pg maintainers"
    }
  ],
  "consumers": {
    "squared_pg": {
      "external": {
        "id": "lua",
        "version": ">=5.4.0 <5.5.0",
        "acquisition": "system"
      },
      "runtime": {
        "model": "none"
      },
      "provides": [
        "script.lua",
        "workspace.lua"
      ],
      "platforms": [
        "termux",
        "linux",
        "macos",
        "desktop"
      ],
      "compatible_templates": [
        "template.terminal.cpp"
      ],
      "requires": {
        "framework": ">=1.0.0 <2.0.0",
        "packages": [],
        "kits": [],
        "engine": ">=0.1.0 <0.2.0",
        "capabilities": [
          "capability.template.substitute@^1.0"
        ]
      },
      "integration_areas": [
        "app.include",
        "build.make.fragments",
        "workspace.lua"
      ],
      "conflicts_with": [],
      "ownership": {
        "generated": [
          "sq_kit/include/squared/kit/lua_host.hpp",
          "mk/kit_lua.mk"
        ],
        "user": [
          "sq_lua/**"
        ],
        "shared": []
      }
    }
  }
}
