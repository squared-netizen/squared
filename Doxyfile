# Squared framework documentation configuration.
#
# Generated documentation is kept under build/docs and is never committed.
# Warnings about undocumented public API and broken references are surfaced,
# not suppressed, so a green run remains meaningful.
#
# Doxygen generates the symbol reference (public headers + showcase) and the
# programmer documentation tree (docs/programmer) as supplementary reading.
# The developer tree (docs/developer) and package payload docs (content/docs)
# are Git-rendered documentation with cross-tree relative links that Doxygen
# resolves against the INPUT root, so they are intentionally excluded here;
# those links surface as warnings rather than being rewritten or hidden.

PROJECT_NAME           = "Squared Framework"
PROJECT_NUMBER         = 0.6.0
PROJECT_BRIEF          = "Modular C++20 application framework distributed as immutable .sq packages"
USE_MDFILE_AS_MAINPAGE = /data/data/com.termux/files/home/projects/squared/README.md

INPUT                  = README.md \
                         docs/programmer \
                         packages/squared-application/content/modules/squared-application/include \
                         packages/squared-data/content/modules/squared-data/include \
                         packages/squared-graphics/content/modules/squared-graphics/include \
                         packages/squared-graphics2d/content/modules/squared-graphics2d/include \
                         packages/squared-gui/content/modules/squared-gui/include \
                         packages/squared-holoDisk/content/modules/squared-holoDisk/include \
                         packages/squared-math/content/modules/squared-math/include \
                         packages/squared-messaging/content/modules/squared-messaging/include \
                         packages/squared-scene2d/content/modules/squared-scene2d/include \
                         packages/squared-time/content/modules/squared-time/include \
                         examples/gui-showcase/include
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp \
                         *.h \
                         *.md
STRIP_FROM_PATH        = packages/ \
                         examples/
EXCLUDE_SYMBOLS        = yyjson_*

OUTPUT_DIRECTORY       = build/docs
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
INTERNAL_DOCS          = NO

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DIRECTORY_GRAPH        = NO
UML_LOOK               = NO
DOT_CLEANUP            = YES

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = build/docs/warnings.txt