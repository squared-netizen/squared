// Subscriber/provider delivery.
// Provider interface + subscription registry; handle-based entries;
// unsubscribe safety during dispatch.
digraph messaging_subscriber_delivery {
  rankdir="LR";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  dispatcher [label="MessageDispatcher", fillcolor="#dae8fc"];
  registry [label="subscription registry\nhandle-based entries\n(shared provider pointers)", fillcolor="#f8cecc"];
  provider [label="Telegraph provider\n(handle_message)", fillcolor="#d5e8d4"];
  broadcast [label="broadcast set\n(delivered to every subscriber)", fillcolor="#f8cecc"];
  directed [label="directed set\n(delivered by provider id)", fillcolor="#f8cecc"];
  pending [label="pending queue\n(delayed telegrams)", fillcolor="#dae8fc"];

  dispatcher -> registry;
  registry -> provider;
  dispatcher -> broadcast;
  dispatcher -> directed;
  dispatcher -> pending;
  provider -> pending [style=dashed, label="provider-generated\n(delayed) messages"];
  provider -> registry [style=dashed, label="unsubscribe during dispatch safe\n(snapshot semantics)"];
}
