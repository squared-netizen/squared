// Snapshot and restore.
// Pending queue serialized to deterministic JSON via squared-data and
// restored into a fresh dispatcher state.
digraph messaging_snapshot_restore {
  rankdir="TB";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  pending [label="pending queue\n(delayed telegrams)", fillcolor="#dae8fc"];
  snapshot [label="snapshot():\nserialize via squared-data\n(deterministic JSON)", fillcolor="#d5e8d4"];
  json [label="JSON snapshot", shape=oval, fillcolor="#fff2cc"];
  restore [label="restore(json):\nrebuild pending entries into\nfresh dispatcher state", fillcolor="#dae8fc"];
  invalid [label="invalid snapshot:\ntagged error, no state change", fillcolor="#ff9999"];

  pending -> snapshot;
  snapshot -> json;
  json -> restore;
  restore -> pending [label="re-queued"];
  restore -> invalid [style=dashed, label="malformed / out of limits"];
}
