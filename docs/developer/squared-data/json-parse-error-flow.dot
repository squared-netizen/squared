// JSON parse ownership and error flow.
// Strict parse via pinned yyjson wrapped by RAII; errors carry position/tags.
digraph json_parse_error_flow {
  rankdir="TB";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  input [label="input bytes + JsonParseOptions\n(maximum_bytes, maximum_depth)", shape=oval, fillcolor="#fff2cc"];
  pool [label="yyjson memory pool\n(RAII: unique_ptr wraps doc/pool)", fillcolor="#ffe6cc"];
  parse [label="yyjson_read with strict flags", fillcolor="#ffe6cc"];
  ok [label="build JsonValue (value semantics)\nType: Null/Boolean/SignedInteger/\nUnsignedInteger/Real/String/Array/Object", fillcolor="#d5e8d4"];
  err [label="error: position + tagged category\n(trailing garbage, invalid number,\ndepth exceeded, allocation limit)", fillcolor="#ff9999"];
  consume [label="application reads members / types", fillcolor="#dae8fc"];

  input -> pool -> parse;
  parse -> ok [label="success"];
  parse -> err [label="failure (document unchanged)"];
  ok -> consume;
  err -> consume [style=dashed, label="caller handles tagged error"];
}
