// Framework package dependency graph.
// Edge set derived exactly from each package manifest.json "module.requires".
// Edges are compile-time/package dependencies between immutable .sq module
// coordinates. Application-owned runtime adapters (e.g. a host selecting a
// backend at link time) are not package requirements and are not shown.
digraph package_dependencies {
  rankdir="LR";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  // Leaf packages with no requires.
  application   [label="squared-application\n0.6.0-dev.5", fillcolor="#dae8fc"];
  data          [label="squared-data\n0.6.0-dev.2", fillcolor="#dae8fc"];
  graphics      [label="squared-graphics\n0.6.0-dev.4", fillcolor="#dae8fc"];
  holoDisk      [label="squared-holoDisk\n0.6.0-dev.3", fillcolor="#dae8fc"];
  math          [label="squared-math\n0.6.0-dev.2", fillcolor="#dae8fc"];
  time          [label="squared-time\n0.6.0-dev.2", fillcolor="#dae8fc"];

  // Consumers.
  graphics2d    [label="squared-graphics2d\n0.6.0-dev.8", fillcolor="#f8cecc"];
  scene2d       [label="squared-scene2d\n0.6.0-dev.8", fillcolor="#f8cecc"];
  backend       [label="squared-backend-sdl2-opengl\n0.6.0-dev.6", fillcolor="#ffe6cc"];
  messaging     [label="squared-messaging\n0.6.0-dev.3", fillcolor="#f8cecc"];
  gui           [label="squared-gui\n0.6.0-dev.17", fillcolor="#d5e8d4"];
  file_picker   [label="squared-gui-file-picker\n0.6.0-dev.3", fillcolor="#fff2cc"];

  graphics2d -> graphics [label="0.6.0-dev.4"];
  graphics2d -> math     [label="0.6.0-dev.2"];
  scene2d    -> graphics2d [label="0.6.0-dev.8"];
  backend    -> graphics2d [label="0.6.0-dev.8"];
  messaging  -> data      [label="0.6.0-dev.2"];
  messaging  -> time      [label="0.6.0-dev.2"];
  gui        -> data      [label="0.6.0-dev.2"];
  gui        -> application [label="0.6.0-dev.5"];
  gui        -> scene2d   [label="0.6.0-dev.8"];
  gui        -> graphics2d [label="0.6.0-dev.8"];
  file_picker -> gui       [label="0.6.0-dev.17"];
  file_picker -> holoDisk  [label="0.6.0-dev.3"];

  // HoloDisk remains independent and optional for core GUI. Only the explicit
  // file-picker integration package requires it.
  { rank=sink; holoDisk; }
}
