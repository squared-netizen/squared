// Hit-test traversal.
// Reverse child order, parent->child coordinate subtraction, recursion.
digraph scene2d_hit_test {
  rankdir="TB";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  stage_coords [label="stage-space point", shape=oval, fillcolor="#fff2cc"];
  hit [label="Group::hit(point)\nreverse iterate children\n(topmost last-added wins)", fillcolor="#f8cecc"];
  to_local [label="convert to child-local:\nsubtract parent position", fillcolor="#dae8fc"];
  recurse [label="recurse into child\n(child hit / bounds test)", fillcolor="#d5e8d4"];
  miss [label="no hit: return nullptr", fillcolor="#ff9999"];

  stage_coords -> hit;
  hit -> to_local;
  to_local -> recurse;
  recurse -> hit [style=dashed, label="nested groups"];
  hit -> miss [label="no child contains point"];
}
