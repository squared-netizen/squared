// Actor/group/stage ownership.
// Group owns children (unique_ptr); Stage owns a Group root; focus is not
// tracked by Scene2D (GUI Ui owns focus).
digraph scene2d_ownership {
  rankdir="TB";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  stage [label="Stage\n(root Group root_)", fillcolor="#dae8fc"];
  group [label="Group\nchildren_: vector<unique_ptr<Actor>>", fillcolor="#f8cecc"];
  actor [label="Actor\n(parent, stage, local transform)", fillcolor="#d5e8d4"];
  gui [label="GUI Ui\nowns focus state (focused_ / set_focus)", fillcolor="#e1d5e7"];

  stage -> group [label="owns root"];
  group -> actor [label="owns children\n(strong-exception-safe add)"];
  actor -> group [style=dashed, label="parent pointer (non-owning)"];
  stage -> gui [style=dashed, label="Scene2D input consumed by GUI;\nno focus primitives here yet"];
}
