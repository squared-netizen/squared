// Backend initialization and shutdown.
// SDL2/OpenGL ES 2 context ownership in squared-backend-sdl2-opengl.
digraph backend_init_shutdown {
  rankdir="TB";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  start [label="host selects backend at link time", shape=oval, fillcolor="#fff2cc"];
  sdl_init [label="SDL_Init (video)", fillcolor="#ffe6cc"];
  attrib [label="GL attributes:\nES profile, major 2, minor 0,\ndouble-buffered, RGBA 8/8/8/8,\ndepth 0, stencil 0", fillcolor="#ffe6cc"];
  window [label="SDL_CreateWindow", fillcolor="#ffe6cc"];
  glcontext [label="SDL_GL_CreateContext", fillcolor="#ffe6cc"];
  vsync [label="SDL_GL_SetSwapInterval(1)\nbest-effort", fillcolor="#ffe6cc"];
  gen [label="generation_ advanced per successful activation", fillcolor="#fff2cc"];
  resources_preserved [label="resources_preserved_ flag\n(decides texture/batch restore strategy)", fillcolor="#fff2cc"];
  run [label="application loop\n(present via SwapWindow)", shape=oval, fillcolor="#fff2cc"];
  teardown [label="destroy GL context -> SDL window -> SDL_Quit", fillcolor="#ffe6cc"];
  done [label="process exit", shape=oval, fillcolor="#fff2cc"];

  start -> sdl_init -> attrib -> window -> glcontext -> vsync -> gen -> resources_preserved -> run;
  run -> teardown [label="shutdown requested"];
  teardown -> done;

  // Context-loss recovery path.
  loss [label="SDL_APP_WILLENTERBACKGROUND / surface lost", fillcolor="#ff9999"];
  gen -> loss [style=dashed];
  loss -> glcontext [style=dashed, label="recreate, generation_++"];
  loss -> resources_preserved [style=dashed, label="report to resources"];
}
