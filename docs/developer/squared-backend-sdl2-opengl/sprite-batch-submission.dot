// SpriteBatch submission path.
// CPU vertex staging -> GPU buffer upload -> single draw call per texture run.
digraph sprite_batch_submission {
  rankdir="LR";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  begin [label="begin(camera)\nglUseProgram, set u_projection,\nenable blend (SRC_ALPHA), disable depth", fillcolor="#dae8fc"];
  draw [label="draw(region|x, y, w, h|Sprite)\nappend_quad: 4 verts x 8 floats\n(x, y, rgba, u, v)", fillcolor="#dae8fc"];
  flush_decision [label="texture changed\nOR sprite_count >= maximum?\n(16383 max, 16-bit indices)", shape=diamond, fillcolor="#fff2cc"];
  flush [label="flush()\nbind texture + buffers,\nglBufferSubData vertices,\nglDrawElements GL_TRIANGLES,\nclear staged vertices", fillcolor="#f8cecc"];
  end [label="end()\nflush remaining, unbind, glUseProgram(0)", fillcolor="#dae8fc"];

  begin -> draw;
  draw -> flush_decision;
  flush_decision -> flush [label="yes"];
  flush_decision -> draw [label="no: keep staging"];
  flush -> draw;
  draw -> end;
}
