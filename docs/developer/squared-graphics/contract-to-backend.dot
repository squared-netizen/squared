// Portable Graphics contract to selected backend.
// squared-graphics declares portable contracts; squared-backend-sdl2-opengl
// implements them at link time (no runtime registration).
digraph graphics_contract_backend {
  rankdir="LR";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  app [label="portable application / gui", shape=oval, fillcolor="#fff2cc"];
  contract [label="squared-graphics contracts\n(Color, graphics context\ncapabilities + lifecycle)", fillcolor="#dae8fc"];
  backend [label="squared-backend-sdl2-opengl\nimplements contracts on SDL2 +\nOpenGL ES 2", fillcolor="#ffe6cc"];
  gpu [label="GL ES 2 device", shape=oval, fillcolor="#e1d5e7"];

  app -> contract [label="uses"];
  contract -> backend [label="link-time selection\n(no runtime backend registry)"];
  backend -> gpu;
}
