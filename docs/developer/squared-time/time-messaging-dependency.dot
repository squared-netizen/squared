// Time-to-Messaging dependency.
// Messaging requires Time (deadlines); Time must not depend on Messaging.
digraph time_messaging_dependency {
  rankdir="LR";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  time [label="squared-time\n0.6.0-dev.2\n(portable, independent)", fillcolor="#d5e8d4"];
  data [label="squared-data\n0.6.0-dev.2", fillcolor="#dae8fc"];
  messaging [label="squared-messaging\n0.6.0-dev.3\n(requires data + time)", fillcolor="#f8cecc"];

  messaging -> time [label="DeadlineQueue for\ndelayed telegrams"];
  messaging -> data [label="JSON snapshot/restore"];
  // No edge from time to messaging: Time stays dependency-free.
  note [label="Time has zero requires in its manifest;\nno edge time -> messaging may exist", shape=note, fillcolor="#fff2cc"];
}
