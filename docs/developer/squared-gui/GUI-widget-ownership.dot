// Widget ownership and layout.
// Composite widget tree under Ui; measure/layout pipeline; Table cells.
digraph gui_widget_ownership {
  rankdir="TB";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  ui [label="Ui\nowns Stage + Skin\n(captures + tooltip state)", fillcolor="#d5e8d4"];
  stage [label="Scene2D Stage\n(Group root)", fillcolor="#dae8fc"];
  skin [label="Skin\nnamed shared fonts/drawables\n+ typed styles", fillcolor="#dae8fc"];
  widget [label="Widget : scene2d::Group\n(Composite node)", fillcolor="#f8cecc"];
  children [label="children_: vector<unique_ptr<Actor>>\nWidget children owned exclusively", fillcolor="#f8cecc"];
  window [label="Window / Dialog\n(owns widgets; modal overlay)", fillcolor="#ffe6cc"];
  table [label="Table\ncells: deque<Cell>", fillcolor="#fff2cc"];
  cell [label="Cell\n(widget*, align, expand, span,\npadding, min/pref/max)", fillcolor="#fff2cc"];
  layout [label="layout pass:\nmeasure preferences upward,\nallocate positions downward\n(validate before draw)", fillcolor="#e1d5e7"];
  tooltip [label="transient tooltip subtree\nStack + Panel + Margin + Label\nor factory-provided Widget", fillcolor="#d5e8d4"];

  ui -> stage;
  ui -> skin;
  stage -> widget;
  stage -> tooltip [label="temporary unique ownership"];
  tooltip -> widget [style=dashed, label="same Composite"];
  widget -> children;
  children -> window [style=dashed];
  window -> table;
  table -> cell;
  cell -> widget [style=dashed, label="borrowed into cell"];
  widget -> layout [style=dashed, label="when relayout needed"];
}
