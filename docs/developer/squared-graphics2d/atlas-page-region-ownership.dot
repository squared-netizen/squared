// Texture-atlas page/region ownership.
// TextureAtlas owns page Textures (unique_ptr); AtlasRegion values are
// non-owning views that reference a page Texture via TextureRegion.
digraph atlas_page_region_ownership {
  rankdir="TB";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  atlas [label="TextureAtlas", fillcolor="#dae8fc"];
  pages [label="vector<unique_ptr<Texture>>\npage textures owned here", fillcolor="#f8cecc"];
  regions [label="vector<AtlasRegion>\nvalue copies, owned here", fillcolor="#f8cecc"];
  region_view [label="AtlasRegion::region_\nTextureRegion (non-owning view:\nTexture*, x, y, w, h, rotated)", fillcolor="#fff2cc"];
  texture [label="Texture\n(GPU handle + dimensions)", fillcolor="#ffe6cc"];

  atlas -> pages;
  atlas -> regions;
  regions -> region_view [label="each region"];
  region_view -> texture [label="borrowed reference\noutlives batch draws"];
  pages -> texture [style=dashed, label="unique ownership"];

  // Commit is the swap at the end of load().
  note [label="load() commits only after\nall pages + regions validate\n(textures_.swap / regions_.swap)", shape=note, fillcolor="#d5e8d4"];
  atlas -> note [style=dotted, constraint=false];
}
