// Portable bitmap-font parsing and glyph-layout transaction.
digraph bitmap_font_layout_flow {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#dae8fc"];

  bytes [label="BMFont text bytes"];
  candidate [label="Bounded candidate parse"];
  index [label="Validate, sort, and index"];
  font [label="Committed BitmapFont", fillcolor="#d5e8d4"];
  utf8 [label="UTF-8 text + options"];
  layout [label="Decode, kern, and align"];
  run [label="Committed GlyphLayout", fillcolor="#d5e8d4"];
  resolver [label="GUI/application page resolver", fillcolor="#fff2cc"];
  batch [label="TextureRegion + SpriteBatch", fillcolor="#f8cecc"];

  bytes -> candidate -> index -> font;
  utf8 -> layout;
  font -> layout -> run;
  font -> resolver;
  run -> resolver -> batch;
}
