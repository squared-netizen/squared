{
  "format": "squared-cartridge",
  "format_version": 2,
  "kind": "template",
  "id": "template.kit",
  "version": "0.1.0",
  "tree": "tree/",
  "title": "Squared kit authoring workspace",
  "description": "A workspace whose deliverable is a kit cartridge: edit a manifest and a payload tree, then check and pack them.",
  "requires_features": [],
  "license": "MIT",
  "authors": [
    {
      "name": "squared-pg maintainers"
    }
  ],
  "consumers": {
    "squared_pg": {
      "project_types": [
        "cartridge"
      ],
      "platforms": [
        "all"
      ],
      "working_directory": "cartridge",
      "processor": "substitute",
      "layers": {
        "application": [
          "cartridge"
        ],
        "build": [
          "Makefile",
          "mk"
        ]
      },
      "integration_areas": [
        "build.make.fragments"
      ],
      "integration_arity": {
        "build.make.fragments": "multi"
      },
      "parameters": [
        {
          "name": "project_name",
          "type": "identifier",
          "required": true,
          "description": "The kit's short name; `format` becomes `kit.format`."
        },
        {
          "name": "external_id",
          "type": "string",
          "required": false,
          "default": "",
          "description": "The external dependency this kit wraps, if any. Empty for a kit that contributes only files."
        },
        {
          "name": "runtime_model",
          "type": "enum",
          "required": false,
          "default": "none",
          "description": "none, polled or callback. See Generator Architecture 2.9.2."
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "default": "A Squared kit.",
          "description": "One-line description, used in the manifest and the README."
        }
      ],
      "requires": {
        "packages": [],
        "kits": {
          "required": [],
          "optional": []
        },
        "engine": ">=0.1.0 <0.2.0",
        "capabilities": [
          "capability.project.plan@^1.0"
        ]
      },
      "ownership": {
        "generated": [
          "mk/squared_generated.mk",
          ".gitignore"
        ],
        "user": [],
        "shared": [],
        "default": "user"
      }
    }
  }
}
