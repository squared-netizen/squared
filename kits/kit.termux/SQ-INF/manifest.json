{
  "format": "squared-cartridge",
  "format_version": 1,

  "kind": "kit",
  "id": "kit.termux",
  "version": "0.1.0",

  "title": "Termux:API Kit",
  "description": "Header-only bridge to the Termux:API command-line tools: battery, clipboard, notifications, dialogs, speech, location, sensors.",

  "engine": { "id": "squared-pg", "version": ">=0.1.0 <0.2.0" },
  "requires_features": [],
  "requires_capabilities": ["capability.template.substitute@^1.0"],
  "license": "MIT",

  "authors": [{ "name": "squared-pg maintainers" }],

  "kit": {
    "external": {
      "id": "termux-api",
      "version": ">=0.50.0",
      "acquisition": "system"
    },

    "provides": [
      "device.battery", "device.clipboard", "device.notification",
      "device.dialog", "device.tts", "device.location", "device.sensor"
    ],

    "platforms": ["termux"],
    "compatible_templates": ["template.terminal.cpp"],

    "requires": {
      "framework": ">=1.0.0 <2.0.0",
      "packages": [],
      "kits": []
    },

    "integration_areas": ["app.include", "build.make.fragments"],

    "conflicts_with": [],

    "ownership": {
      "generated": ["sq_kit/include/squared/kit/termux.hpp", "mk/kit_termux.mk"],
      "user": [],
      "shared": []
    }
  }
}
