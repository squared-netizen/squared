{
  "format": "squared-cartridge",
  "format_version": 2,
  "kind": "kit",
  "id": "kit.terminal",
  "version": "0.2.0",
  "tree": "tree/",
  "title": "Terminal Kit",
  "description": "A single header of simple terminal utilities: console I/O, a small regex facade, and a libGDX-style FileHandle. Standard library only.",
  "requires_features": [],
  "license": "MIT",
  "authors": [
    {
      "name": "squared-pg maintainers"
    }
  ],
  "consumers": {
    "squared_pg": {
      "provides": [
        "console.io",
        "text.regex",
        "files.handle"
      ],
      "compatible_templates": [
        "template.terminal.cpp",
        "template.term.edu.cpp"
      ],
      "integration_areas": [
        "app.include",
        "build.make.fragments"
      ],
      "conflicts_with": [
        "kit.ncurses"
      ],
      "requires": {
        "engine": ">=0.1.0 <0.2.0",
        "packages": []
      },
      "ownership": {
        "generated": [
          "sq_kit/**",
          "mk/kit_terminal.mk"
        ],
        "user": [],
        "shared": []
      }
    }
  }
}
