{
  "format": "squared-cartridge",
  "format_version": 1,
  "kind": "kit",
  "id": "kit.lua",
  "version": "0.1.0",
  "title": "Lua Scripting Kit",
  "description": "Adds an embedded Lua 5.4 interpreter and an sq_lua/ script workspace alongside sq_app/.",
  "engine": {
    "id": "squared-pg",
    "version": ">=0.1.0 <0.2.0"
  },
  "requires_features": [],
  "requires_capabilities": [
    "capability.template.substitute@^1.0"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "squared-pg maintainers"
    }
  ],
  "kit": {
    "external": {
      "id": "lua",
      "version": ">=5.4.0 <5.5.0",
      "acquisition": "system"
    },
    "provides": [
      "script.lua",
      "workspace.lua"
    ],
    "platforms": [
      "termux",
      "linux",
      "desktop"
    ],
    "compatible_templates": [
      "template.termux.cpp"
    ],
    "requires": {
      "framework": ">=1.0.0 <2.0.0",
      "packages": [],
      "kits": []
    },
    "integration_areas": [
      "app.include",
      "build.make.fragments",
      "workspace.lua"
    ],
    "conflicts_with": [],
    "ownership": {
      "generated": [
        "sq_kit/include/squared/kit/lua_host.hpp",
        "mk/kit_lua.mk"
      ],
      "user": [
        "sq_lua/**"
      ],
      "shared": []
    }
  }
}
